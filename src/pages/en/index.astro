---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TrustStripHero from '@components/TrustStripHero.astro';
import ProblemSection from '@components/ProblemSection.astro';
import NotWhatSection from '@components/NotWhatSection.astro';
import HowItWorks from '@components/HowItWorks.astro';
import SampleAuditSection from '@components/SampleAuditSection.astro';
import LLMsRow from '@components/LLMsRow.astro';
import PaidFeaturesPreview from '@components/PaidFeaturesPreview.astro';
import TestimonialsSection from '@components/TestimonialsSection.astro';
import ComparisonTable from '@components/ComparisonTable.astro';
import PricingSection from '@components/PricingSection.astro';
import FounderNote from '@components/FounderNote.astro';
import FAQSection from '@components/FAQSection.astro';
import FinalCTA from '@components/FinalCTA.astro';
import Footer from '@components/Footer.astro';
import SectionDivider from '@components/SectionDivider.astro';
import { t } from '@i18n/index';

const locale = 'en' as const;
const d = t(locale);
---
<BaseLayout
  locale={locale}
  title={d.meta.title}
  description={d.meta.description}
  ogAlt={d.meta.ogAlt}
  canonicalPath="/en"
>
  <Hero locale={locale} />
  <TrustStripHero locale={locale} />
  <ProblemSection locale={locale} />
  <NotWhatSection locale={locale} />
  <SectionDivider />
  <HowItWorks locale={locale} />
  <SampleAuditSection locale={locale} />
  <LLMsRow locale={locale} />
  <PaidFeaturesPreview locale={locale} />
  <TestimonialsSection locale={locale} />
  <ComparisonTable locale={locale} />
  <PricingSection locale={locale} />
  <FounderNote locale={locale} />
  <SectionDivider />
  <FAQSection locale={locale} />
  <FinalCTA locale={locale} />
  <Footer locale={locale} />
</BaseLayout>
