---
import type { Locale } from '@i18n/index';
import { t } from '@i18n/index';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).cta;
---

<section class="relative py-24 sm:py-32 lg:py-40 overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute inset-x-0 -top-20 h-[420px]"
         style="background: radial-gradient(ellipse 60% 80% at 50% 0%, rgba(124, 58, 237, 0.25), transparent 70%);"></div>
  </div>

  <div class="max-w-3xl mx-auto px-6 lg:px-10 text-center" data-reveal>
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-balance">
      {d.title.split(' ').slice(0, -1).join(' ')}{' '}
      <span class="gradient-text">{d.title.split(' ').slice(-1)[0]}</span>
    </h2>
    <p class="mt-5 text-base sm:text-lg text-[var(--color-ink-secondary)] leading-relaxed">
      {d.subline}
    </p>
    <a href="#hero-form" class="btn-primary mt-9 inline-flex">
      {d.button}
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
</section>
