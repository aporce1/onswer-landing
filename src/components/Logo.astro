---
/**
 * Onswer logo — animated SVG.
 *
 * On mount:
 *   1) outer "O" ring draws in via strokeDasharray (1.2s)
 *   2) center dot fades in and starts a continuous gentle pulse
 *   3) ripple wave emanates from the dot every 3s
 *
 * Use:
 *   <Logo size={48} withText showText />
 */

interface Props {
  /** Pixel size of the icon (square). Defaults to 40. */
  size?: number;
  /** Whether to render the "Onswer" wordmark next to the icon. */
  withText?: boolean;
  /** Whether to show "MVP" / "Beta" badge after the wordmark. */
  badge?: string;
  /** className passthrough on the wrapper. */
  class?: string;
}
const { size = 40, withText = true, badge, class: className = '' } = Astro.props;
---

<a href="/" class={`onswer-logo inline-flex items-center gap-2.5 group ${className}`} aria-label="Onswer home">
  <span class="onswer-logo-mark relative inline-block" style={`width:${size}px;height:${size}px`}>
    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" class="block w-full h-full">
      <defs>
        <linearGradient id="onswer-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%"  stop-color="#4F46E5"/>
          <stop offset="50%" stop-color="#7C3AED"/>
          <stop offset="100%" stop-color="#06B6D4"/>
        </linearGradient>
        <radialGradient id="onswer-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%"   stop-color="#7C3AED" stop-opacity="0.45"/>
          <stop offset="100%" stop-color="#7C3AED" stop-opacity="0"/>
        </radialGradient>
      </defs>

      <!-- Soft glow halo -->
      <circle cx="32" cy="32" r="28" fill="url(#onswer-glow)" class="onswer-halo"/>

      <!-- Ripple waves (continuous) -->
      <circle cx="32" cy="32" r="14" fill="none"
              stroke="url(#onswer-grad)" stroke-width="0.8"
              class="onswer-ripple onswer-ripple-1" opacity="0"/>
      <circle cx="32" cy="32" r="14" fill="none"
              stroke="url(#onswer-grad)" stroke-width="0.8"
              class="onswer-ripple onswer-ripple-2" opacity="0"/>

      <!-- Outer "O" ring — draws in once on load -->
      <circle cx="32" cy="32" r="20" fill="none"
              stroke="url(#onswer-grad)" stroke-width="3"
              stroke-linecap="round"
              stroke-dasharray="125.66"
              stroke-dashoffset="125.66"
              class="onswer-ring"
              transform="rotate(-90 32 32)"/>

      <!-- Center dot — fades in then pulses softly -->
      <circle cx="32" cy="32" r="5" fill="url(#onswer-grad)"
              class="onswer-dot"
              opacity="0"/>
    </svg>
  </span>

  {withText && (
    <span class="flex items-baseline gap-1.5">
      <span class="text-lg font-semibold tracking-tight text-[var(--color-ink)]">Onswer</span>
      {badge && (
        <span class="text-[10px] uppercase tracking-[0.18em] px-1.5 py-0.5 rounded-md border border-[var(--color-line)] text-[var(--color-ink-muted)] bg-white/60">
          {badge}
        </span>
      )}
    </span>
  )}
</a>

<style>
  /* Initial draw-in of the outer ring */
  .onswer-ring {
    animation: ringDraw 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes ringDraw {
    to { stroke-dashoffset: 0; }
  }

  /* Center dot — appears after the ring, then breathes */
  .onswer-dot {
    transform-origin: 32px 32px;
    animation:
      dotIn 0.5s ease-out 1.1s forwards,
      dotPulse 3s ease-in-out 1.7s infinite;
  }
  @keyframes dotIn {
    to { opacity: 1; }
  }
  @keyframes dotPulse {
    0%, 100% { transform: scale(1);    opacity: 1; }
    50%      { transform: scale(1.12); opacity: 0.92; }
  }

  /* Ripples — staggered, continuous */
  .onswer-ripple {
    transform-origin: 32px 32px;
  }
  .onswer-ripple-1 {
    animation: rippleExpand 3.2s ease-out 2.1s infinite;
  }
  .onswer-ripple-2 {
    animation: rippleExpand 3.2s ease-out 3.7s infinite;
  }
  @keyframes rippleExpand {
    0%   { transform: scale(0.4); opacity: 0.6; }
    100% { transform: scale(1.7); opacity: 0;   }
  }

  /* Soft halo behind the icon, very subtle */
  .onswer-halo {
    transform-origin: 32px 32px;
    animation: haloPulse 4s ease-in-out infinite;
  }
  @keyframes haloPulse {
    0%, 100% { transform: scale(0.92); opacity: 0.55; }
    50%      { transform: scale(1.0);  opacity: 0.8;  }
  }

  /* Hover: slight scale on the whole mark */
  .onswer-logo:hover .onswer-logo-mark {
    transform: scale(1.04);
  }
  .onswer-logo-mark {
    transition: transform 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .onswer-ring,
    .onswer-dot,
    .onswer-ripple-1,
    .onswer-ripple-2,
    .onswer-halo {
      animation: none !important;
    }
    .onswer-ring { stroke-dashoffset: 0; }
    .onswer-dot  { opacity: 1; }
  }
</style>
