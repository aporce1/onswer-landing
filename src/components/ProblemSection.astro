---
import type { Locale } from '@i18n/index';
import { t } from '@i18n/index';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).problem;

// Icon SVG paths keyed by name — keep them tiny + dependency-free
const ICONS: Record<string, string> = {
  'eye-off':  '<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/>',
  'users':    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'compass':  '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
};
---

<section class="relative py-24 sm:py-32 lg:py-40 border-t border-[var(--color-line)]">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="text-center max-w-3xl mx-auto" data-reveal>
      <span class="pill"><span class="dot"></span>{d.pill}</span>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-balance">
        {d.title}
      </h2>
      <p class="mt-5 text-base sm:text-lg text-[var(--color-ink-secondary)] leading-relaxed text-balance">
        {d.subline}
      </p>
    </div>

    <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal>
      {d.items.map(({ icon, title, body }) => (
        <article class="card p-7">
          <div class="w-11 h-11 rounded-xl grid place-items-center text-white"
               style="background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); box-shadow: 0 8px 24px -8px rgba(79,70,229,0.5);">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[icon] || ''} />
          </div>
          <h3 class="mt-5 font-semibold text-lg text-[var(--color-ink)]">{title}</h3>
          <p class="mt-2 text-sm text-[var(--color-ink-secondary)] leading-relaxed">{body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
