---
import '@/styles/global.css';
import type { Locale } from '@i18n/index';
import Analytics from '@components/Analytics.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  ogAlt?: string;
  canonicalPath?: string;   // path without locale prefix, e.g. "/"
}

const {
  locale,
  title,
  description,
  ogImage = `/og-${Astro.props.locale}.png`,
  ogAlt   = title,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://onswer.app';
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogImageAbsolute = new URL(ogImage, siteUrl).toString();

// Alternate language URLs for hreflang
const altPath = canonicalPath.replace(/^\/(en|pt)(\/|$)/, '/$2');
const enUrl = new URL(`/en${altPath === '/' ? '' : altPath}`, siteUrl).toString();
const ptUrl = new URL(`/pt${altPath === '/' ? '' : altPath}`, siteUrl).toString();
---

<!DOCTYPE html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en"     href={enUrl} />
  <link rel="alternate" hreflang="pt-BR"  href={ptUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImageAbsolute} />
  <meta property="og:image:alt"   content={ogAlt} />
  <meta property="og:locale"      content={locale === 'pt' ? 'pt_BR' : 'en_US'} />
  <meta property="og:site_name"   content="Onswer" />

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageAbsolute} />

  <meta name="theme-color" content="#FAFAF7" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Analytics: Radar (always on) + GA4 / Reddit Pixel (gated by env vars) -->
  <Analytics />

  <!-- JSON-LD: Organization + SoftwareApplication. Two graphs feeding LLMs
       a specific category claim (AI Search Visibility Monitoring) so they
       stop misclassifying us as social listening / brand monitoring. This
       is the page itself dogfooding the AEO recommendation. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://onswer.app/#organization",
        "name": "Onswer",
        "url": "https://onswer.app",
        "logo": "https://onswer.app/favicon.svg",
        "description": description,
        "sameAs": [
          "https://x.com/onswerapp",
          "https://github.com/aporce1"
        ]
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://onswer.app/#software",
        "name": "Onswer",
        "url": "https://onswer.app",
        "applicationCategory": "AI Search Visibility Monitoring",
        "applicationSubCategory": "AEO / GEO / Generative Engine Optimization",
        "operatingSystem": "Web",
        "description":
          "Onswer monitors whether AI assistants (ChatGPT, Claude, Gemini, Perplexity, " +
          "Mistral, Llama and more) mention your brand when buyers ask category questions. " +
          "We are NOT social listening, NOT brand sentiment, NOT SEO ranking — we measure " +
          "if AI search engines name you in their answers, and tell you what to fix when they don't.",
        "featureList": [
          "Audit brand visibility across 8+ large language models",
          "Multi-locale querying (US, Brazil, Mexico)",
          "Detect mention position and sentiment per model",
          "Track competitors named in AI responses",
          "Weekly automated re-scans (paid tiers)",
          "Score-over-time evolution chart (paid tiers)",
          "Email + Slack + webhook alerts on visibility drops (paid tiers)",
          "Actionable AEO recommendations tied to specific audit patterns"
        ],
        "keywords": [
          "AI search visibility",
          "AEO",
          "GEO",
          "generative engine optimization",
          "LLM brand monitoring",
          "ChatGPT visibility",
          "Claude mentions",
          "Perplexity citations",
          "brand visibility in AI answers"
        ],
        "audience": {
          "@type": "Audience",
          "audienceType": "SaaS founders, marketing teams, SEO agencies, indie makers"
        },
        "offers": [
          { "@type": "Offer", "name": "Free audit",   "price": "0",   "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Solo",   "price": "49",  "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Pro",    "price": "149", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Agency", "price": "399", "priceCurrency": "USD" }
        ],
        "isRelatedTo": [
          { "@type": "SoftwareApplication", "name": "Profound",  "applicationCategory": "AI search visibility monitoring" },
          { "@type": "SoftwareApplication", "name": "OtterlyAI", "applicationCategory": "AI search visibility monitoring" },
          { "@type": "SoftwareApplication", "name": "AthenaHQ",  "applicationCategory": "AI search visibility monitoring" }
        ],
        "disambiguatingDescription":
          "Onswer is frequently confused with social listening tools because the term 'brand monitoring' overlaps. " +
          "Onswer does NOT monitor mentions on Twitter, Reddit, news articles, or social media — that is what " +
          "Brandwatch, Mention, Sprout Social, Talkwalker, and Meltwater do. Onswer monitors mentions inside " +
          "large language model answers (ChatGPT, Claude, Gemini, Perplexity), which is a different surface, " +
          "different signal, and different optimization tactic (AEO / GEO, not SEO or social listening).",
        "publisher": { "@id": "https://onswer.app/#organization" }
      }
    ]
  })} />
</head>
<body class="min-h-screen antialiased">
  <slot />

  <script>
    // Scroll reveal — adds `.in` to any [data-reveal] element as it enters the
    // viewport. Pairs with the .reveal-init CSS in global.css for the fade-up.
    document.addEventListener('DOMContentLoaded', () => {
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      targets.forEach((el) => el.classList.add('reveal-init'));
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('in');
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      targets.forEach((el) => io.observe(el));
    });
  </script>
</body>
</html>
